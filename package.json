{
	"name": "helloasso-webhooks",
	"version": "2.0.0",
	"private": true,
	"description": "Notifications HelloAsso : routeur de paiements vers Notion (cotisations) et Discord (inscriptions WEI).",
	"license": "UNLICENSED",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.5.2",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"dev:pretty": "tsx watch src/server.ts | pino-pretty",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/server.js",
		"backfill:wei": "tsx src/scripts/backfillWei.ts",
		"check": "tsc --noEmit",
		"lint": "prettier --check . && eslint . --max-warnings=0",
		"format": "prettier --write . && eslint . --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run --coverage",
		"ci": "pnpm check && pnpm lint && pnpm test:unit && pnpm build"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"@notionhq/client": "^5.26.0",
		"@supabase/supabase-js": "^2.116.0",
		"hono": "^4.13.7",
		"pino": "^10.3.1",
		"zod": "^4.6.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.5.1",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.12.0",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.9.6",
		"prettier-plugin-organize-imports": "^4.3.0",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^4.1.11"
	}
}
