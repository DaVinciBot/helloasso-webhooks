{
	"name": "helloasso-webhooks",
	"version": "2.0.0",
	"private": true,
	"description": "Notifications HelloAsso : routeur de paiements vers Notion (cotisations) et Discord (inscriptions WEI).",
	"license": "UNLICENSED",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.5.2",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"dev:pretty": "tsx watch src/server.ts | pino-pretty",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/server.js",
		"backfill:wei": "tsx src/scripts/backfillWei.ts",
		"check": "tsc --noEmit",
		"lint": "prettier --check . && eslint . --max-warnings=0",
		"format": "prettier --write . && eslint . --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run --coverage",
		"ci": "pnpm check && pnpm lint && pnpm test:unit && pnpm build"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.5",
		"@notionhq/client": "^5.28.0",
		"@supabase/supabase-js": "^2.118.0",
		"hono": "^4.13.13",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"pino-pretty": "^13.2.0",
		"prettier": "^3.9.10",
		"prettier-plugin-organize-imports": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "^5.0.5"
	}
}
