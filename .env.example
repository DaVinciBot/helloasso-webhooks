# Configuration du service helloasso-webhooks.
#
# En local :  cp .env.example .env   puis remplir les valeurs <À_REMPLIR>.
# Sur le VPS : un fichier par environnement, en chmod 600 —
#              /srv/hook/prod/.env  et  /srv/hook/staging/.env
#
# Le fichier est organisé comme le code : un socle commun, puis un bloc par
# handler. Un bloc absent DÉSACTIVE son handler — le WEI s'éteint hors saison
# sans toucher au code, et staging peut n'en câbler qu'un seul. Au moins un
# handler doit rester activé, sinon le service refuse de démarrer.
#
# Les deux environnements se distinguent par le WEBHOOK_SECRET, le jeu de
# variables HELLOASSO_* (bac à sable pour staging), la base Notion visée et les
# salons Discord. Tout le reste est identique.
#
# Toutes ces variables sont validées au démarrage (src/core/config.ts) : si
# l'une manque ou est invalide, le process refuse de se lancer et liste d'un
# coup toutes les fautives. Ce fichier ne doit contenir aucun secret réel :
# `.env` est ignoré par git.

# ---------------------------------------------------------------- Service ---

# Port d'écoute interne du conteneur.
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Secret présent dans l'URL du webhook : https://hook.davincibot.fr/webhook/<ce secret>
# Seule barrière d'authentification — les comptes association HelloAsso ne
# signent pas leurs notifications. Minimum 24 caractères.
# Générer avec :  openssl rand -hex 32
WEBHOOK_SECRET=<À_REMPLIR>

# ------------------------------------------------------------- HelloAsso ---
#
# Commun à tous les handlers : c'est le compte de l'association, et la façon
# d'en relire les paiements.

# Espace API de HelloAsso → « Mes clients API ».
HELLOASSO_CLIENT_ID=<À_REMPLIR>
HELLOASSO_CLIENT_SECRET=<À_REMPLIR>

# Slug de l'organisation, tel qu'il apparaît dans l'URL HelloAsso :
# https://www.helloasso.com/associations/<ce slug>
# Sert à écarter les paiements qui ne concernent pas l'association.
HELLOASSO_ORG_SLUG=<À_REMPLIR>

# Production :  https://api.helloasso.com/v5     + https://api.helloasso.com/oauth2/token
# Bac à sable : https://api.helloasso-sandbox.com/v5 + https://api.helloasso-sandbox.com/oauth2/token
HELLOASSO_API_BASE=https://api.helloasso.com/v5
HELLOASSO_TOKEN_URL=https://api.helloasso.com/oauth2/token

# Statuts de paiement autorisant une action, séparés par des virgules.
HELLOASSO_ACCEPTED_STATES=Authorized,Processed

# --------------------------------------------------------------- Supabase ---
#
# Commun aux deux handlers : idempotence des paiements, et registre du WEI.

# https://<ref-du-projet>.supabase.co
SUPABASE_URL=<À_REMPLIR>

# Clé service_role (Dashboard → Project Settings → API). Contourne la RLS :
# ne jamais l'exposer côté client ni la committer.
SUPABASE_SERVICE_ROLE_KEY=<À_REMPLIR>

# --------------------------------------------------------------- Alerting ---

# Webhook Discord prévenu quand le service a bien fonctionné mais que la donnée
# est fautive : cotisation payée sans ligne Notion, commande WEI sans
# participant identifiable, annonce non délivrée. C'est le salon des incidents,
# pas celui des bonnes nouvelles. Laisser vide pour désactiver (l'évènement
# reste loggé).
ALERT_WEBHOOK_URL=

# =========================================================================
#  HANDLER « membership » — cotisation marqué dans Notion
#
#  Activé par la présence de NOTION_TOKEN. Dès qu'il est défini, tout le bloc
#  NOTION_* devient obligatoire : un demi-bloc est une faute de configuration,
#  pas une désactivation.
# =========================================================================

# Campagne dont ce handler a la charge. Laisser le slug vide accepte toutes les
# campagnes du type indiqué — c'est le réglage courant, l'association n'ayant
# qu'un formulaire d'adhésion à la fois. Le routage préfère toujours le handler
# le plus précis, donc un WEI de type Event ne sera jamais capté par ici.
# Le slug est celui de l'URL du formulaire :
# https://www.helloasso.com/associations/<org>/adhesions/<ce slug>
MEMBERSHIP_FORM_TYPE=Membership
MEMBERSHIP_FORM_SLUG=

# Jeton d'intégration interne (https://www.notion.so/my-integrations).
# L'intégration doit être explicitement connectée à la base.
# VIDE = handler cotisation désactivé.
NOTION_TOKEN=<À_REMPLIR>

# Id de la *source de données* interrogée — pas celui de la base, ni celui d'une
# vue. Depuis l'API 2025-09-03 une base est un contenant : ce sont ses sources de
# données qui portent les lignes et se requêtent.
# Menu `•••` de la base → « Manage data sources » → « Copy data source ID ».
NOTION_DATA_SOURCE_ID=<À_REMPLIR>

# Version d'API épinglée. Ne pas suivre les nouvelles versions sans relire
# docs/architecture.md § Notion. Une version antérieure à 2025-09-03 ignore les
# sources de données : elle est refusée au démarrage.
NOTION_VERSION=2025-09-03

# Nom exact de la propriété contenant l'adresse email du membre, casse et
# accents compris.
NOTION_EMAIL_PROPERTY=<À_REMPLIR>

# Type de cette propriété : email | rich_text | title.
# Le filtre de recherche Notion n'a pas la même forme selon le type.
NOTION_EMAIL_PROPERTY_TYPE=email

# Nom exact de la propriété d'état (Status) portant la cotisation.
NOTION_PAID_PROPERTY=<À_REMPLIR>

# Libellé de l'option à poser sur cette propriété quand la cotisation est payée.
# Transmis tel quel à Notion : reprends le libellé au caractère près, accents et
# majuscules compris (« Payé » n'est pas « paye »). Une option inconnue de la
# propriété fait échouer l'écriture avec un validation_error.
NOTION_PAID_STATUS=Payé

# Nom exact de la propriété nombre recevant le montant revenu à l'association.
NOTION_AMOUNT_PROPERTY=<À_REMPLIR>

# Colonnes prénom et nom de l'adhérent. Elles servent de repli quand aucune
# ligne ne porte son adresse, et de seul critère quand un tiers a réglé la
# cotisation — l'email connu est alors celui du payeur, pas celui du membre.
# Les deux ou aucune : renseigner une seule est refusé au démarrage. Laisser
# vides pour n'apparier que sur l'email.
# La comparaison ignore la casse, les accents, les traits d'union et les
# apostrophes, des deux côtés.
NOTION_FIRST_NAME_PROPERTY=
NOTION_LAST_NAME_PROPERTY=

# =========================================================================
#  HANDLER « wei » — place inscrite au registre, arrivants annoncés
#
#  Activé par la présence de WEI_DISCORD_WEBHOOK_URL : un handler qui ne peut
#  pas annoncer n'a aucun intérêt. WEI_FORM_SLUG devient alors obligatoire.
# =========================================================================

# Campagne du WEI. Le slug est celui de l'URL du formulaire :
# https://www.helloasso.com/associations/<org>/evenements/<ce slug>
#
# Contrairement à la cotisation, le slug est EXIGÉ : sans lui, le sélecteur se
# réduirait à « tous les évènements » et attraperait la première billetterie
# venue — une place de WEI attribuée à un spectateur de gala n'est pas un
# incident qu'on veut découvrir sur Discord.
WEI_FORM_TYPE=Event
WEI_FORM_SLUG=<À_REMPLIR>

# Salon Discord des annonces d'inscription. Distinct de ALERT_WEBHOOK_URL : les
# bonnes nouvelles et les incidents ne se lisent pas au même endroit.
# VIDE = handler WEI désactivé.
WEI_DISCORD_WEBHOOK_URL=

# Nombre de places du séjour. Renseigné, les annonces affichent « 23 / 60
# places » et le nombre de places restantes ; laissé vide, elles affichent le
# seul total d'inscrits.
#
# Pourquoi une variable et pas une lecture de HelloAsso : leur API v5 n'expose
# ni le quota d'un tarif, ni le nombre de billets restants. Ces informations
# n'existent que dans leur interface web.
WEI_CAPACITY=

# --------------------------------------------------------------- Timeouts ---

# Délai maximal d'un appel sortant (HelloAsso, Notion, Supabase, Discord).
HTTP_TIMEOUT_MS=8000

# Budget total du traitement d'une notification. Doit rester nettement sous la
# limite de HelloAsso (~15 s) pour garantir une réponse avant coupure.
PROCESS_TIMEOUT_MS=12000
